#!/usr/bin/env bash
# Run from any directory. Only the project's RTL and SystemVerilog benches are inputs.
set -euo pipefail
cd "$(dirname "$0")/.."
case ${1:-check} in
  check|format) mode=${1:-check} ;;
  *) echo "usage: $0 [check|format]" >&2; exit 2 ;;
esac

formatter=${VERIBLE_FORMATTER:-verible-verilog-format}
if ! command -v "$formatter" >/dev/null; then
  echo "Install verible-verilog-format or set VERIBLE_FORMATTER to its path." >&2
  exit 1
fi

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
status=0
while IFS= read -r -d '' source; do
  if [[ $mode == format ]]; then
    "$formatter" --flagfile=.verible-format --inplace "$source"
  else
    "$formatter" --flagfile=.verible-format "$source" >"$tmp"
    if ! cmp -s "$source" "$tmp"; then
      echo "Needs formatting: $source" >&2
      status=1
    fi
  fi
done < <(find rtl test -type f -name '*.sv' -print0)
exit "$status"
